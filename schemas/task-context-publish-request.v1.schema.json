{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwm.local/schemas/task-context-publish-request.v1.schema.json",
  "title": "hwm-task-context-publish-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "repository",
    "transport_issue",
    "expected_base",
    "publication_branch",
    "task",
    "artifact",
    "candidate",
    "ci"
  ],
  "properties": {
    "schema": {"const": "hwm-task-context-publish-request/v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$"},
    "repository": {"const": "Dsamofalov/hwm-context"},
    "transport_issue": {"const": 27},
    "expected_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "publication_branch": {
      "type": "string",
      "pattern": "^publisher/task-context/i[0-9]{2}-[0-9]{4}/[a-z0-9][a-z0-9._-]{7,95}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_key", "issue_repository", "issue_number", "source_request_id", "source_request_sha256"],
      "properties": {
        "task_key": {"type": "string", "pattern": "^I[0-9]{2}-[0-9]{4}$"},
        "issue_repository": {"const": "Dsamofalov/hwm-control"},
        "issue_number": {"type": "integer", "minimum": 1},
        "source_request_id": {"type": "string", "pattern": "^tcr1-[0-9a-f]{64}$"},
        "source_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "blob_sha", "content_sha256", "mode", "pack_schema"],
          "properties": {
            "op": {"const": "add"},
            "path": {"type": "string", "pattern": "^tasks/I[0-9]{2}-[0-9]{4}/context\\.json$"},
            "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "mode": {"const": "100644"},
            "pack_schema": {"const": "hwm-task-context-pack/v1"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "blob_sha", "content_sha256", "mode", "pack_schema", "expected_blob_sha"],
          "properties": {
            "op": {"const": "replace"},
            "path": {"type": "string", "pattern": "^tasks/I[0-9]{2}-[0-9]{4}/context\\.json$"},
            "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "mode": {"const": "100644"},
            "pack_schema": {"const": "hwm-task-context-pack/v1"},
            "expected_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_sha", "parent_count", "tree_policy"],
      "properties": {
        "parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parent_count": {"const": 1},
        "tree_policy": {"const": "base-plus-exact-task-context-blob"}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "required_check", "status_integration_id"],
      "properties": {
        "workflow": {"const": "repository-bootstrap-ci.yml"},
        "required_check": {"const": "bootstrap"},
        "status_integration_id": {"const": 15368}
      }
    }
  }
}
